{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": false,
    "checkJs": false,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "strict": true
  },
  "include": ["src/**/*", "tests/**/*", "src/**/*.svelte"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
